# Generated documentation bundle (tools/docs_pdf.py); build output, not source.
dist/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local database (WAL mode leaves these companions next to it); data/*.db* keeps the
# pre-migration backups private too.
*.db
data/*.db*
*.db-wal
*.db-shm
*.sqlite3
# The local web server writes its stdout log here; it is machine state, not source.
data/*.log

# ---------------------------------------------------------------------------
# LLM credentials. config/llm.example.toml is the committed template; the local
# file may contain an API key and must never be pushed.
# ---------------------------------------------------------------------------
config/llm.local.toml
config/volume.local.yaml
config/exercises/demands.local.yaml
config/strength-relationships.local.yaml
.env

# ---------------------------------------------------------------------------
# PERSONAL DATA — never commit, never push.
# This repository is public. The raw exports contain a complete training history,
# bodyweight, readiness scores and derived strength metrics.
# ---------------------------------------------------------------------------
data/raw/*
data/export/
private/

# Tests that read the real export and assert values derived from it must stay private.
# They are ignored here and untracked with `git rm --cached`.
tests/*_integration.py

# Anything that looks like a personal export
*backupDB*.csv
*backupReadiness*.csv
