# Derived-analytics maintenance worker (C-1), one reconciliation run.
#
# Installed as /etc/systemd/system/strength-analytics-maintenance.service and started by
# strength-analytics-maintenance.timer. It runs the same checkout and virtual environment as the
# web service, so a backend deployment is picked up by the next run without updating a separate
# long-lived worker. The web unit starts one run after a restart (see its ExecStartPost).

[Unit]
Description=Strength Coach derived analytics maintenance (one run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dsh
Group=dsh
WorkingDirectory=/home/dsh/strength-training-app
Environment=HOME=/home/dsh
Environment=PATH=/home/dsh/strength-training-app/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/London
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1800
ExecStart=/home/dsh/strength-training-app/.venv/bin/python -m strength_coach.cli --db data/coach.db analytics build
