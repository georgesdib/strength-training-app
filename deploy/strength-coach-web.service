[Unit]
Description=Strength Coach web UI (home network)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
WorkingDirectory=/home/dsh/strength-training-app
Environment=HOME=/home/dsh
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/dsh/strength-training-app/tools/start_web.sh
# C-1: after a backend deployment/restart, reconcile derived analytics once with the new code.
# The leading dash keeps the web service healthy if the maintenance unit is not installed.
ExecStartPost=-/bin/systemctl --no-block start strength-analytics-maintenance.service
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
